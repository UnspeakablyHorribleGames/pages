# Local preview only. GitHub Pages builds the live site with its own pinned versions
# (https://pages.github.com/versions/); this matches them so a local build looks the same.
source "https://rubygems.org"

gem "github-pages", "~> 232", group: :jekyll_plugins

# Ruby 3 no longer bundles the web server that `jekyll serve` uses.
gem "webrick", "~> 1.8"

# Windows has no system time zone database for Ruby to read.
gem "tzinfo-data"
