---
layout: null
permalink: /releases.xml
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Unspeakably Horrible Games — Releases</title>
  <subtitle>Just the ships: posts tagged release or major-release.</subtitle>
  <link href="{{ site.url }}/releases.xml" rel="self"/>
  <link href="{{ site.url }}/devlog/"/>
  <id>{{ site.url }}/releases.xml</id>
  {% assign releases = site.posts | where_exp: "p", "p.tags contains 'release' or p.tags contains 'major-release'" %}
  {% if releases.size > 0 %}<updated>{{ releases.first.date | date_to_xmlschema }}</updated>{% endif %}
  {% for post in releases %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    {% for tag in post.tags %}<category term="{{ tag | xml_escape }}"/>{% endfor %}
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
